---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
    <meta charset="UTF-8" />
    <meta name="description" content="Astro description" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg"/>
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <!-- Applies the saved theme before the first paint to avoid a flash of the wrong colors -->
    <script is:inline>
      (() => {
        const media = window.matchMedia('(prefers-color-scheme: dark)');

        const getPreference = () => {
          const stored = localStorage.getItem('theme');
          return stored === 'dark' || stored === 'light' ? stored : 'system';
        };

        const apply = (preference) => {
          const isDark = preference === 'dark' || (preference === 'system' && media.matches);
          document.documentElement.classList.toggle('dark', isDark);
          document.documentElement.dataset.themePreference = preference;
        };

        window.__theme = {
          get: getPreference,
          set: (preference) => {
            if (preference === 'system') {
              localStorage.removeItem('theme');
            } else {
              localStorage.setItem('theme', preference);
            }
            apply(preference);
          },
        };

        media.addEventListener('change', () => apply(getPreference()));
        apply(getPreference());
      })();
    </script>
	</head>
	<body>
		<slot />
	</body>
</html>
<style is:global>
	:root {
		color-scheme: light;
		--bg: #fff;
		--text: #111;
		--text-secondary: #222;
		--text-muted: #666;
		--text-subtle: #555;
		--text-faint: #777;
		--surface: #eee;
		--surface-hover: #eee;
		--surface-text: #111;
		--border: #f2f2f2;
		--border-soft: #eee;
		--border-strong: #c0bebe;
		--border-hover: #8a8a8a;
		--footer-bg: #fdfdfd;
		--active: #00bb00;
		--inactive: #d60202;
	}

	/* Dark colors only on screen: printing always uses the light palette */
	@media screen {
		html.dark {
			color-scheme: dark;
			--bg: #0f1115;
			--text: #ececec;
			--text-secondary: #d6d6d6;
			--text-muted: #a3a3a3;
			--text-subtle: #a8a8a8;
			--text-faint: #9a9a9a;
			--surface: #22262d;
			--surface-hover: #2c3139;
			--surface-text: #e6e6e6;
			--border: #262a31;
			--border-soft: #2c3139;
			--border-strong: #3d424a;
			--border-hover: #6b717a;
			--footer-bg: #14171c;
			--active: #2fd34a;
			--inactive: #ff4d4d;
		}
	}

	html {
		font-family: Menlo,
			Monaco,
			Lucida Console,
			'Courier New',
			Courier,
			monospace;
		background-color: var(--bg);
		color: var(--text);
		letter-spacing: -0.025rem;
	}

	body,
	figure {
		margin: 0;
		padding: 0;
	}

	a {
		text-decoration: none;
	}

	ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	*, *::before, *::after {
		box-sizing: border-box;
	}

	h1, h2, h3, h4 {
		margin: 0;
		font-family:
			system-ui,
			-apple-system,
			BlinkMacSystemFont,
			'Segoe UI',
			Roboto,
			Oxygen,
			Ubuntu,
			Cantarell,
			'Open Sans',
			'Helvetica Neue',
			sans-serif;
	}

	p {
		color: var(--text-muted);
		font-size: 0.9rem;
		line-height: 1.5;
		margin: 0;
		text-wrap: pretty;
	}

  .paragraphSpace {
    padding-top: 8px;
  }

  @media print {
    .no-print {
      display: none !important;
    }
  }

  .print {
    display: none !important;
  }

  @media print {
    .print {
      display: block !important;
    }
  }

</style>
